<?xml version="1.0" encoding="UTF-8"?>
<definitions name="TaskService"
             targetNamespace="http://www.example.org/tasks"
             xmlns:tns="http://www.example.org/tasks"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

    <types>
        <xsd:schema targetNamespace="http://www.example.org/tasks">
            <xsd:element name="GetTasksRequest">
                <xsd:complexType/>
            </xsd:element>
            <xsd:element name="GetTasksResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="tasks" type="tns:Task" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="AddTaskRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="title" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="AddTaskResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="task" type="tns:Task"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:complexType name="Task">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="title" type="xsd:string"/>
                    <xsd:element name="completed" type="xsd:boolean"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:schema>
    </types>

    <message name="GetTasksRequest">
        <part name="parameters" element="tns:GetTasksRequest"/>
    </message>
    <message name="GetTasksResponse">
        <part name="parameters" element="tns:GetTasksResponse"/>
    </message>
    <message name="AddTaskRequest">
        <part name="parameters" element="tns:AddTaskRequest"/>
    </message>
    <message name="AddTaskResponse">
        <part name="parameters" element="tns:AddTaskResponse"/>
    </message>

    <portType name="TaskPortType">
        <operation name="GetTasks">
            <input message="tns:GetTasksRequest"/>
            <output message="tns:GetTasksResponse"/>
        </operation>
        <operation name="AddTask">
            <input message="tns:AddTaskRequest"/>
            <output message="tns:AddTaskResponse"/>
        </operation>
    </portType>

    <binding name="TaskBinding" type="tns:TaskPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="GetTasks">
            <soap:operation soapAction="GetTasks"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="AddTask">
            <soap:operation soapAction="AddTask"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="TaskService">
        <port name="TaskPort" binding="tns:TaskBinding">
            <soap:address location="http://localhost:3000/soap"/>
        </port>
    </service>
</definitions>
